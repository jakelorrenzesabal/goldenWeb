<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Golden Success College - Official Website featuring Campus Events Calendar and Bulletin Board System" />
    <title>@ViewData["Title"] - Golden Success College</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/golenWeb.styles.css" asp-append-version="true" />
    <style>
        :root {
            --gsc-green: #0b5e28;
            --gsc-dark-green: #073d1a;
            --gsc-gold: #e6b800;
            --gsc-navy: #1b2a4a;
        }

        body { background-color: #f5f7f5; }

        .gsc-navbar {
            background: linear-gradient(90deg, var(--gsc-dark-green) 0%, var(--gsc-navy) 100%);
            border-bottom: 3px solid var(--gsc-gold);
            box-shadow: 0 2px 16px rgba(0,0,0,0.3);
        }

        .gsc-brand-text {
            line-height: 1.15;
        }

        .gsc-brand-text .college-name {
            font-size: 1.05rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: 0.5px;
        }

        .gsc-brand-text .tagline {
            font-size: 0.68rem;
            color: var(--gsc-gold);
            letter-spacing: 0.5px;
        }

        .nav-link.gsc-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 600;
            padding: 0.5rem 0.9rem !important;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .nav-link.gsc-link:hover, .nav-link.gsc-link.active {
            color: var(--gsc-gold) !important;
            background: rgba(255,255,255,0.08);
        }

        .nav-link.gsc-link i { margin-right: 4px; }

        footer.gsc-footer {
            background: linear-gradient(90deg, var(--gsc-dark-green), var(--gsc-navy));
            color: rgba(255,255,255,0.8);
            border-top: 3px solid var(--gsc-gold);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg gsc-navbar py-2">
            <div class="container">
                <!-- Brand Logo & Name -->
                <a class="navbar-brand d-flex align-items-center gap-3 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Golden Success College Logo" style="height:52px; width:52px; object-fit:contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));" />
                    <div class="gsc-brand-text">
                        <div class="college-name">Golden Success College</div>
                        <div class="tagline">Determination &bull; Courage &bull; Hardwork &bull; Isa. 33:6</div>
                    </div>
                </a>

                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarGSC"
                        aria-controls="navbarGSC" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarGSC">
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link gsc-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gsc-link" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event text-warning"></i>Events Calendar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gsc-link" asp-controller="Bulletins" asp-action="Index">
                                <i class="bi bi-megaphone text-warning"></i>Bulletin Board
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gsc-link" asp-controller="CrudTest" asp-action="Index">
                                <i class="bi bi-lightning-charge text-warning"></i>API Tester
                            </a>
                        </li>
                        <li class="nav-item ms-1">
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <a class="nav-link gsc-link" asp-controller="Account" asp-action="Index">
                                        <i class="bi bi-people"></i>Users
                                    </a>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning fw-bold">
                                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="gsc-footer mt-5 py-4">
        <div class="container text-center">
            <div class="mb-2">
                <img src="~/images/logo.png" alt="GSC Logo" style="height:40px; opacity:0.85;" />
            </div>
            <p class="mb-1 fw-bold" style="color: #f0c040;">Golden Success College</p>
            <p class="small mb-0 text-white-50">&copy; @DateTime.Now.Year Golden Success College &bull; All Rights Reserved &bull; <em>Isa. 33:6</em></p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
