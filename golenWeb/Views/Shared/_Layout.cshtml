<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Golden Success College - Official Website featuring Campus Events Calendar and Bulletin Board System" />
    @if (ViewData["OgTitle"] != null)
    {
        <meta property="og:title" content="@ViewData["OgTitle"]" />
        <meta property="og:description" content="@ViewData["OgDescription"]" />
        <meta property="og:image" content="@ViewData["OgImage"]" />
        <meta property="og:url" content="@ViewData["OgUrl"]" />
        <meta property="og:type" content="article" />
    }
    <script>
        (function() {
            var theme = localStorage.getItem('gsc_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <title>@(ViewData["SiteTitle"] ?? ViewData["Title"]) - @(ViewData["CollegeName"] ?? "Golden Success College")</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/golenWeb.styles.css" asp-append-version="true" />
    <style>
        :root {
            --gsc-green: @(ViewData["PrimaryColor"] ?? "#0b5e28");
            --gsc-dark-green: @(ViewData["NavBackground"] ?? "#073d1a");
            --gsc-gold: @(ViewData["AccentColor"] ?? "#f59e0b");
            --gsc-gold-hover: #d97706;
            --gsc-navy: #0f172a;
            --gsc-bg: #f8fafc;
            --gsc-card-border: rgba(226, 232, 240, 0.9);
        }

        body {
            background-color: var(--gsc-bg);
            color: #1e293b;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
        }

        .gsc-navbar {
            background: linear-gradient(135deg, var(--gsc-dark-green) 0%, #0d5225 60%, var(--gsc-navy) 100%);
            border-bottom: 3px solid var(--gsc-gold);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .gsc-brand-text { line-height: 1.2; }

        .gsc-brand-text .college-name {
            font-size: 1.15rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.2px;
        }

        .gsc-brand-text .tagline {
            font-size: 0.72rem;
            color: var(--gsc-gold);
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .nav-link.gsc-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            position: relative;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-link.gsc-link:hover, .nav-link.gsc-link.active {
            color: #ffffff !important;
            background: rgba(255,255,255,0.12);
            transform: translateY(-1px);
        }

        .nav-link.gsc-link i {
            transition: transform 0.25s ease;
            margin-right: 5px;
            display: inline-block;
        }

        .nav-link.gsc-link:hover i {
            transform: scale(1.2);
        }

        .role-badge-admin {
            font-size: 0.65rem;
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: #0f172a;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
        }

        .role-badge-user {
            font-size: 0.65rem;
            background: rgba(255,255,255,0.25);
            color: #ffffff;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .user-info-nav {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #ffffff;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gsc-gold), #fbbf24);
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.9rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

        .user-avatar:hover {
            transform: scale(1.1) rotate(5deg);
        }

        footer.gsc-footer {
            background: linear-gradient(135deg, var(--gsc-dark-green) 0%, var(--gsc-navy) 100%);
            color: rgba(255,255,255,0.85);
            border-top: 3px solid var(--gsc-gold);
        }

        .announcement-banner {
            background: linear-gradient(90deg, #f59e0b, #fbbf24);
            color: #0f172a;
            font-weight: 700;
            font-size: 0.9rem;
            padding: 9px 0;
            text-align: center;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.2);
        }

        .toast-success {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            min-width: 320px;
            animation: slideInRight 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes slideInRight {
            from { transform: translateX(110%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* --- GLOBAL ANIMATION CLASSES --- */
        .animate-fade-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-delay-1 { animation-delay: 0.1s; }
        .animate-delay-2 { animation-delay: 0.2s; }
        .animate-delay-3 { animation-delay: 0.3s; }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Modern Card Micro-interactions */
        .card-modern {
            background: #ffffff;
            border: 1px solid var(--gsc-card-border);
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .card-modern:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px rgba(11, 94, 40, 0.1);
            border-color: rgba(11, 94, 40, 0.3);
        }

        .btn-modern {
            border-radius: 10px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body>
    @{
        var showBanner = ViewData["ShowAnnouncementBanner"]?.ToString() == "true";
        var bannerText = ViewData["AnnouncementBanner"]?.ToString();
    }
    @if (showBanner && !string.IsNullOrWhiteSpace(bannerText))
    {
        <div class="announcement-banner">
            <i class="bi bi-megaphone-fill me-2"></i>@bannerText
        </div>
    }

    <header style="background-color: #fff; border-bottom: 1px solid var(--cc-slate-200); position: sticky; top: 0; z-index: 1030;" class="shadow-sm">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container-fluid px-4">
                <!-- Brand Logo & Name -->
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px; background-color: var(--cc-green-surface); border: 1px solid var(--cc-green-border);">
                        <img src="~/images/logo.png" alt="GSC Logo" style="height:26px; width:26px; object-fit:contain;" />
                    </span>
                    <div>
                        <span style="font-size: 0.95rem; font-weight: 800; color: var(--cc-slate-900); display: block; line-height: 1.1;">@(ViewData["CollegeName"] ?? "Golden Success College")</span>
                        <span style="font-size: 0.65rem; color: var(--cc-slate-500); font-weight: 600; letter-spacing: 0.04em;">CAMPUS EVENTS &amp; BULLETIN SYSTEM</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarGSC"
                        aria-controls="navbarGSC" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarGSC">
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1 text-success"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Events Calendar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="Bulletins" asp-action="Index">
                                <i class="bi bi-megaphone me-1 text-warning"></i>Bulletin Board
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <!-- Dashboard link for all logged-in users -->
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1 text-info"></i>Dashboard
                                </a>
                            </li>
                            <!-- Customize Site — both roles -->
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="SiteSettings" asp-action="Index">
                                    <i class="bi bi-palette me-1 text-purple" style="color:#9333ea;"></i>Customize
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Admin-only: Manage Users -->
                                <li class="nav-item">
                                    <a class="nav-link px-3 py-2 fw-semibold text-secondary rounded" asp-controller="Account" asp-action="Index">
                                        <i class="bi bi-people-fill me-1 text-danger"></i>Users
                                    </a>
                                </li>
                            }

                            <!-- User Dropdown Menu -->
                            <li class="nav-item dropdown ms-2">
                                <a class="text-decoration-none d-inline-flex align-items-center gap-2 px-3 py-1 rounded border"
                                   href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="background-color: var(--cc-slate-50); border-color: var(--cc-slate-200) !important; font-size: 0.85rem; color: var(--cc-slate-600);">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold"
                                          style="width: 28px; height: 28px; background-color: var(--cc-blue-surface); color: var(--cc-blue-text); border: 1px solid var(--cc-blue-border); font-size: 0.80rem;">
                                        @User.Identity!.Name!.Substring(0, 1).ToUpper()
                                    </span>
                                    <span class="fw-bold" style="color: var(--cc-slate-900);">@User.Identity!.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="pill-cc-orange ms-1">ADMIN</span>
                                    }
                                    else
                                    {
                                        <span class="pill-cc-blue ms-1">USER</span>
                                    }
                                    <i class="bi bi-chevron-down ms-1" style="font-size: 0.68rem; color: var(--cc-slate-400);"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2"
                                    aria-labelledby="userMenu" style="min-width: 240px; border-radius: 12px; overflow: hidden;">
                                    <li>
                                        <div class="px-3 py-2 bg-light">
                                            <div class="cc-section-label mb-1">Signed in as</div>
                                            <div class="fw-bold" style="font-size: 0.85rem; color: var(--cc-slate-900);">@User.Identity!.Name</div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider my-0" style="border-color: var(--cc-slate-100);"></li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2 small" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 text-muted"></i> Dashboard Overview
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2 small" asp-controller="SiteSettings" asp-action="Index">
                                            <i class="bi bi-palette text-muted"></i> Customize Website
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-0" style="border-color: var(--cc-slate-100);"></li>
                                    <li>
                                        <!-- Sign out is a POST form with token per design-system.md -->
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-soft-danger w-100 justify-content-center py-2">
                                                <i class="bi bi-box-arrow-right"></i> Sign out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        <!-- Light/Dark Theme Toggle Button -->
                        <li class="nav-item ms-2">
                            <button class="btn btn-soft-secondary px-3 py-1 d-flex align-items-center gap-2" id="themeToggleBtn" onclick="toggleTheme()" type="button" title="Toggle Light/Dark Theme" style="height: 38px;">
                                <i class="bi bi-moon-stars-fill text-warning" id="themeIcon"></i>
                                <span class="d-none d-xl-inline small fw-bold" id="themeText">Dark</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Success/Error Toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-success toast show border-0 shadow-lg" role="alert" id="successToast">
            <div class="toast-header bg-success text-white border-0">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" onclick="document.getElementById('successToast').remove()"></button>
            </div>
            <div class="toast-body fw-semibold">
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 py-4 border-top" style="background-color: #ffffff; border-color: var(--cc-slate-200) !important;">
        <div class="container text-center">
            <div class="mb-2">
                <img src="~/images/logo.png" alt="GSC Logo" style="height:36px; opacity:0.85;" />
            </div>
            <p class="mb-1 fw-bold" style="color: var(--cc-slate-900);">@(ViewData["CollegeName"] ?? "Golden Success College")</p>
            <p class="small mb-0 text-muted">&copy; @DateTime.Now.Year @(ViewData["FooterText"] ?? "Golden Success College • All Rights Reserved") &bull; <em>Isa. 33:6</em></p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Auto-dismiss success toast after 4s
        setTimeout(function () {
            var t = document.getElementById('successToast');
            if (t) t.remove();
        }, 4000);
    </script>

    <!-- GLOBAL EVENT DETAILS MODAL (design-system.md aligned) -->
    <div class="modal fade" id="gscEventModal" tabindex="-1" aria-labelledby="gscEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3 overflow-hidden">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background-color: var(--cc-blue-surface);">
                            <i class="bi bi-calendar-event" style="color: var(--cc-blue-text); font-size: 0.95rem;"></i>
                        </div>
                        <div>
                            <span id="evtModalCategory" class="pill-cc-blue me-2">Category</span>
                            <h6 class="fw-bold mb-0 d-inline" id="evtModalTitle" style="color: var(--cc-slate-900); font-size: 1.05rem;">Event Title</h6>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div id="evtModalImageContainer" class="mb-3 text-center d-none">
                        <img id="evtModalImage" src="" alt="Event" class="img-fluid rounded-3 shadow-sm w-100" style="max-height:300px; object-fit:cover;" />
                    </div>
                    <div class="row g-2 p-3 rounded-3 mb-3 border small" style="background-color: var(--cc-slate-50); border-color: var(--cc-slate-200) !important;">
                        <div class="col-md-6">
                            <i class="bi bi-calendar3 text-primary me-1"></i><strong>Date:</strong> <span id="evtModalDate">---</span>
                        </div>
                        <div class="col-md-6">
                            <i class="bi bi-clock text-success me-1"></i><strong>Time:</strong> <span id="evtModalTime">---</span>
                        </div>
                        <div class="col-md-6">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>Venue:</strong> <span id="evtModalLocation">---</span>
                        </div>
                        <div class="col-md-6">
                            <i class="bi bi-person-badge text-secondary me-1"></i><strong>Organizer:</strong> <span id="evtModalOrganizer">---</span>
                        </div>
                    </div>
                    <p class="cc-section-label mb-2"><i class="bi bi-info-circle me-1"></i> Description &amp; Details</p>
                    <p id="evtModalDescription" style="white-space: pre-line; color: var(--cc-slate-600); font-size: 0.88rem;">---</p>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 d-flex justify-content-between">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-soft-primary" id="evtModalFbBtn">
                            <i class="bi bi-facebook"></i> Share to FB
                        </button>
                        <button type="button" class="btn btn-soft-success" id="evtModalCopyBtn">
                            <i class="bi bi-link-45deg"></i> Copy Link
                        </button>
                    </div>
                    <a id="evtModalFullLink" href="#" class="btn btn-soft-secondary">View Full Details</a>
                </div>
                <div class="cc-gradient-bar-blue"></div>
            </div>
        </div>
    </div>

    <!-- GLOBAL BULLETIN DETAILS MODAL (design-system.md aligned) -->
    <div class="modal fade" id="gscBulletinModal" tabindex="-1" aria-labelledby="gscBulletinModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3 overflow-hidden">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background-color: var(--cc-orange-surface);">
                            <i class="bi bi-megaphone-fill" style="color: var(--cc-orange-text); font-size: 0.95rem;"></i>
                        </div>
                        <div>
                            <span id="bulModalPriority" class="pill-cc-red me-2">Priority</span>
                            <h6 class="fw-bold mb-0 d-inline" id="bulModalTitle" style="color: var(--cc-slate-900); font-size: 1.05rem;">Bulletin Title</h6>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div id="bulModalImageContainer" class="mb-3 text-center d-none">
                        <img id="bulModalImage" src="" alt="Bulletin" class="img-fluid rounded-3 shadow-sm w-100" style="max-height:300px; object-fit:cover;" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3 border small" style="background-color: var(--cc-slate-50); border-color: var(--cc-slate-200) !important;">
                        <div><i class="bi bi-tag text-warning me-1"></i>Category: <strong id="bulModalCategory">---</strong></div>
                        <div><i class="bi bi-person-fill text-success me-1"></i>Author: <strong id="bulModalAuthor">---</strong></div>
                        <div><i class="bi bi-calendar-event me-1"></i>Date: <strong id="bulModalDate">---</strong></div>
                    </div>
                    <p class="cc-section-label mb-2"><i class="bi bi-card-text me-1"></i> Notice Content</p>
                    <p id="bulModalContent" style="white-space: pre-line; color: var(--cc-slate-600); font-size: 0.88rem;">---</p>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 d-flex justify-content-between">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-soft-primary" id="bulModalFbBtn">
                            <i class="bi bi-facebook"></i> Share to FB
                        </button>
                        <button type="button" class="btn btn-soft-success" id="bulModalCopyBtn">
                            <i class="bi bi-link-45deg"></i> Copy Link
                        </button>
                    </div>
                    <a id="bulModalFullLink" href="#" class="btn btn-soft-secondary">View Full Notice</a>
                </div>
                <div class="cc-gradient-bar-orange"></div>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function updateThemeUI(theme) {
            const icon = document.getElementById('themeIcon');
            const text = document.getElementById('themeText');
            if (theme === 'dark') {
                if (icon) icon.className = 'bi bi-sun-fill text-warning';
                if (text) text.textContent = 'Light';
            } else {
                if (icon) icon.className = 'bi bi-moon-stars-fill text-warning';
                if (text) text.textContent = 'Dark';
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('gsc_theme', newTheme);
            updateThemeUI(newTheme);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const theme = localStorage.getItem('gsc_theme') || 'light';
            updateThemeUI(theme);
        });
    </script>
</body>
</html>
