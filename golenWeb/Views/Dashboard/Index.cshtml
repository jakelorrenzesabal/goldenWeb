@using golenWeb.Models
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = (bool)(ViewData["IsAdmin"] ?? false);
    var username = ViewData["Username"]?.ToString() ?? "User";
    var role = ViewData["Role"]?.ToString() ?? "User";
    var eventCount = (int)(ViewData["EventCount"] ?? 0);
    var bulletinCount = (int)(ViewData["BulletinCount"] ?? 0);
    var userCount = (int)(ViewData["UserCount"] ?? 0);
    var recentEvents = ViewData["RecentEvents"] as List<EventModel> ?? new List<EventModel>();
    var recentBulletins = ViewData["RecentBulletins"] as List<Bulletin> ?? new List<Bulletin>();
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, var(--gsc-dark-green, #073d1a) 0%, #1b2a4a 100%);
        border-radius: 16px;
        color: white;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .dashboard-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: rgba(230, 184, 0, 0.08);
    }

    .dashboard-hero::after {
        content: '';
        position: absolute;
        bottom: -30%;
        right: 10%;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
    }

    .stat-card {
        background: white;
        border-radius: 14px;
        padding: 1.5rem;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }

    .stat-number {
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #888;
    }

    .action-card {
        background: white;
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        border: 2px solid transparent;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        transition: all 0.2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 1rem;
        color: #2d2d2d;
    }

    .action-card:hover {
        border-color: var(--gsc-gold, #e6b800);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        color: #2d2d2d;
        transform: translateX(4px);
    }

    .action-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666;
        margin-bottom: 1rem;
    }

    .admin-badge {
        background: linear-gradient(135deg, #e6b800, #f5d020);
        color: #1a1a1a;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
</style>

<!-- Dashboard Hero -->
<div class="dashboard-hero">
    <div class="d-flex align-items-center gap-3 mb-2" style="position:relative;z-index:1;">
        <div style="width:56px;height:56px;border-radius:50%;background:var(--gsc-gold,#e6b800);color:#1a1a1a;display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:800;">
            @username.Substring(0, 1).ToUpper()
        </div>
        <div>
            <div style="font-size:1.4rem;font-weight:800;">Welcome back, @username! 👋</div>
            <div class="d-flex align-items-center gap-2 mt-1">
                @if (isAdmin)
                {
                    <span class="admin-badge"><i class="bi bi-shield-fill-check me-1"></i>Administrator</span>
                    <span style="color:rgba(255,255,255,0.7);font-size:0.85rem;">You have full access to all features</span>
                }
                else
                {
                    <span style="background:rgba(255,255,255,0.2);color:white;font-size:0.7rem;font-weight:700;padding:3px 10px;border-radius:20px;text-transform:uppercase;">User</span>
                    <span style="color:rgba(255,255,255,0.7);font-size:0.85rem;">Content editor access</span>
                }
            </div>
        </div>
    </div>
    <p style="color:rgba(255,255,255,0.6);margin:0;font-size:0.9rem;position:relative;z-index:1;">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, MMMM d, yyyy")
    </p>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e8f5e9;">
                <i class="bi bi-calendar-event" style="color:#0b5e28;"></i>
            </div>
            <div class="stat-number" style="color:#0b5e28;">@eventCount</div>
            <div class="stat-label">Campus Events</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fff8e1;">
                <i class="bi bi-megaphone" style="color:#e6a000;"></i>
            </div>
            <div class="stat-number" style="color:#e6a000;">@bulletinCount</div>
            <div class="stat-label">Bulletin Posts</div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:#e3f2fd;">
                    <i class="bi bi-people" style="color:#1565c0;"></i>
                </div>
                <div class="stat-number" style="color:#1565c0;">@userCount</div>
                <div class="stat-label">Registered Users</div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:#fce4ec;">
                    <i class="bi bi-palette" style="color:#c62828;"></i>
                </div>
                <div class="stat-number" style="color:#c62828;font-size:1.6rem;">Live</div>
                <div class="stat-label">Site Customization</div>
            </div>
        </div>
    }
</div>

<!-- PICTURE HEADLINES SHOWCASE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <div class="fw-bold text-dark fs-5">
            <i class="bi bi-image text-success me-2"></i>Campus Headlines & Hashed Picture Attachments
        </div>
        <a asp-controller="Events" asp-action="Create" class="btn btn-sm btn-success fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Upload Picture Event
        </a>
    </div>
    <div class="card-body p-4 pt-0">
        <div class="row g-3">
            @if (!recentEvents.Any() && !recentBulletins.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-images fs-1 d-block mb-2"></i>
                    <p>No headlines or pictures posted yet. Create an event or bulletin with a picture to display here!</p>
                </div>
            }
            else
            {
                @foreach (var ev in recentEvents)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm overflow-hidden bg-light">
                            @if (ev.ImageData != null)
                            {
                                <img src="/Events/Image/@ev.Id" alt="@ev.Title" class="w-100" style="height: 140px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 d-flex align-items-center justify-content-center text-warning" style="height: 140px; background: linear-gradient(135deg, #0b5e28, #1b2a4a); font-size: 2.5rem;">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                            }
                            <div class="card-body p-3">
                                <span class="badge bg-success mb-1">Event &bull; @ev.Category</span>
                                <div class="fw-bold text-dark text-truncate" title="@ev.Title">@ev.Title</div>
                                <small class="text-muted d-block mt-1"><i class="bi bi-geo-alt me-1"></i>@ev.Location</small>
                            </div>
                        </div>
                    </div>
                }
                @foreach (var b in recentBulletins.Take(2))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm overflow-hidden bg-light">
                            @if (b.ImageData != null)
                            {
                                <img src="/Bulletins/Image/@b.Id" alt="@b.Title" class="w-100" style="height: 140px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 d-flex align-items-center justify-content-center text-warning" style="height: 140px; background: linear-gradient(135deg, #1b2a4a, #073d1a); font-size: 2.5rem;">
                                    <i class="bi bi-megaphone"></i>
                                </div>
                            }
                            <div class="card-body p-3">
                                <span class="badge bg-warning text-dark mb-1">Bulletin &bull; @b.Category</span>
                                <div class="fw-bold text-dark text-truncate" title="@b.Title">@b.Title</div>
                                <small class="text-muted d-block mt-1"><i class="bi bi-person me-1"></i>@b.Author</small>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4">
    <!-- Events Actions -->
    <div class="col-lg-6">
        <div class="section-title"><i class="bi bi-calendar3 me-2"></i>Events Management</div>
        <div class="d-flex flex-column gap-3">
            <a asp-controller="Events" asp-action="Create" class="action-card">
                <div class="action-icon" style="background:#e8f5e9;">
                    <i class="bi bi-plus-circle" style="color:#0b5e28;"></i>
                </div>
                <div>
                    <div class="fw-700" style="font-weight:700;">Add New Event</div>
                    <div class="text-muted" style="font-size:0.82rem;">Schedule a campus event or activity</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-controller="Events" asp-action="Index" class="action-card">
                <div class="action-icon" style="background:#f1f8e9;">
                    <i class="bi bi-list-ul" style="color:#558b2f;"></i>
                </div>
                <div>
                    <div style="font-weight:700;">View All Events</div>
                    <div class="text-muted" style="font-size:0.82rem;">Browse, edit, or delete events</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
        </div>
    </div>

    <!-- Bulletins Actions -->
    <div class="col-lg-6">
        <div class="section-title"><i class="bi bi-megaphone me-2"></i>Bulletin Board</div>
        <div class="d-flex flex-column gap-3">
            <a asp-controller="Bulletins" asp-action="Create" class="action-card">
                <div class="action-icon" style="background:#fff8e1;">
                    <i class="bi bi-plus-square" style="color:#e6a000;"></i>
                </div>
                <div>
                    <div style="font-weight:700;">Post New Bulletin</div>
                    <div class="text-muted" style="font-size:0.82rem;">Create an announcement or notice</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-controller="Bulletins" asp-action="Index" class="action-card">
                <div class="action-icon" style="background:#fffde7;">
                    <i class="bi bi-journals" style="color:#f9a825;"></i>
                </div>
                <div>
                    <div style="font-weight:700;">Manage Bulletins</div>
                    <div class="text-muted" style="font-size:0.82rem;">View, edit, or remove bulletins</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
        </div>
    </div>

    <!-- Site Customization -->
    <div class="col-lg-6">
        <div class="section-title"><i class="bi bi-palette me-2"></i>Site Customization</div>
        <div class="d-flex flex-column gap-3">
            <a asp-controller="SiteSettings" asp-action="Index" class="action-card">
                <div class="action-icon" style="background:#fce4ec;">
                    <i class="bi bi-brush" style="color:#c62828;"></i>
                </div>
                <div>
                    <div style="font-weight:700;">Customize Website</div>
                    <div class="text-muted" style="font-size:0.82rem;">Edit hero text, colors, tagline, footer & more</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-controller="Home" asp-action="Index" class="action-card">
                <div class="action-icon" style="background:#e8eaf6;">
                    <i class="bi bi-eye" style="color:#3949ab;"></i>
                </div>
                <div>
                    <div style="font-weight:700;">Preview Live Site</div>
                    <div class="text-muted" style="font-size:0.82rem;">See how the homepage looks to visitors</div>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
        </div>
    </div>

    <!-- Admin-only: User Management -->
    @if (isAdmin)
    {
        <div class="col-lg-6">
            <div class="section-title">
                <i class="bi bi-shield-fill-check me-2"></i>Admin Controls
                <span class="admin-badge ms-2">Admin Only</span>
            </div>
            <div class="d-flex flex-column gap-3">
                <a asp-controller="Account" asp-action="Index" class="action-card">
                    <div class="action-icon" style="background:#e3f2fd;">
                        <i class="bi bi-people-fill" style="color:#1565c0;"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;">Manage Users</div>
                        <div class="text-muted" style="font-size:0.82rem;">Create, edit, delete accounts & assign roles</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </a>
                <a asp-controller="Account" asp-action="Create" class="action-card">
                    <div class="action-icon" style="background:#e8eaf6;">
                        <i class="bi bi-person-plus-fill" style="color:#3949ab;"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;">Add New User</div>
                        <div class="text-muted" style="font-size:0.82rem;">Create account with Admin or User role</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </a>
            </div>
        </div>
    }
</div>
