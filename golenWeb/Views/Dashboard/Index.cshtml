@using golenWeb.Models
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = (bool)(ViewData["IsAdmin"] ?? false);
    var username = ViewData["Username"]?.ToString() ?? "User";
    var role = ViewData["Role"]?.ToString() ?? "User";
    var eventCount = (int)(ViewData["EventCount"] ?? 0);
    var bulletinCount = (int)(ViewData["BulletinCount"] ?? 0);
    var userCount = (int)(ViewData["UserCount"] ?? 0);
    var recentEvents = ViewData["RecentEvents"] as List<EventModel> ?? new List<EventModel>();
    var recentBulletins = ViewData["RecentBulletins"] as List<Bulletin> ?? new List<Bulletin>();
}

<!-- Dashboard Page Header Card (design-system.md) -->
<div class="card cc-card border-0 shadow-sm mb-4">
    <div class="card-body px-4 py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width: 44px; height: 44px; background-color: var(--cc-blue-surface); color: var(--cc-blue-text); border: 1px solid var(--cc-blue-border); font-size: 1.1rem;">
                    @username.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <h4 class="fw-bold mb-0" style="color: var(--cc-slate-900); font-size: 1.25rem;">
                        Welcome back, @username! 👋
                    </h4>
                    <p class="mb-0" style="font-size: 0.75rem; color: var(--cc-slate-400); text-transform: uppercase; letter-spacing: 0.07em;">
                        @DateTime.Now.ToString("dddd, MMMM d, yyyy") &bull; @(isAdmin ? "Administrator Portal Access" : "Content Editor Access")
                    </p>
                </div>
            </div>
            <div>
                @if (isAdmin)
                {
                    <span class="pill-cc-orange"><i class="bi bi-shield-fill-check me-1"></i>ADMINISTRATOR</span>
                }
                else
                {
                    <span class="pill-cc-blue"><i class="bi bi-person-fill me-1"></i>USER ROLE</span>
                }
            </div>
        </div>
    </div>
    <div class="cc-gradient-bar-rainbow"></div>
</div>

<!-- Stat Cards (design-system.md spec) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card cc-card border-0 shadow-sm h-100">
            <div class="card-body px-4 py-3">
                <p class="cc-section-label mb-2">
                    <i class="bi bi-calendar-event me-1"></i> Campus Events
                </p>
                <h3 class="fw-bold mb-0" style="color: var(--cc-blue-text); font-size: 2.2rem;">
                    @eventCount
                </h3>
                <small style="font-size: 0.75rem; color: var(--cc-slate-400);">Scheduled calendar events</small>
            </div>
            <div class="cc-gradient-bar-blue"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card cc-card border-0 shadow-sm h-100">
            <div class="card-body px-4 py-3">
                <p class="cc-section-label mb-2">
                    <i class="bi bi-megaphone me-1"></i> Bulletin Posts
                </p>
                <h3 class="fw-bold mb-0" style="color: var(--cc-orange-text); font-size: 2.2rem;">
                    @bulletinCount
                </h3>
                <small style="font-size: 0.75rem; color: var(--cc-slate-400);">Published official notices</small>
            </div>
            <div class="cc-gradient-bar-orange"></div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="col-md-4">
            <div class="card cc-card border-0 shadow-sm h-100">
                <div class="card-body px-4 py-3">
                    <p class="cc-section-label mb-2">
                        <i class="bi bi-people me-1"></i> Registered Users
                    </p>
                    <h3 class="fw-bold mb-0" style="color: var(--cc-green-text); font-size: 2.2rem;">
                        @userCount
                    </h3>
                    <small style="font-size: 0.75rem; color: var(--cc-slate-400);">Active accounts</small>
                </div>
                <div class="cc-gradient-bar-green"></div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-4">
            <div class="card cc-card border-0 shadow-sm h-100">
                <div class="card-body px-4 py-3">
                    <p class="cc-section-label mb-2">
                        <i class="bi bi-palette me-1"></i> Site Customization
                    </p>
                    <h3 class="fw-bold mb-0" style="color: var(--cc-purple-text); font-size: 1.8rem;">
                        Active
                    </h3>
                    <small style="font-size: 0.75rem; color: var(--cc-slate-400);">Live website theme editor</small>
                </div>
                <div class="cc-gradient-bar-purple"></div>
            </div>
        </div>
    }
</div>

<!-- Recent Headlines Showcase -->
<div class="card cc-card border-0 shadow-sm mb-4">
    <div class="card-body px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="cc-section-label mb-0"><i class="bi bi-images me-1"></i> Campus Headlines &amp; Picture Attachments</p>
            <a asp-controller="Events" asp-action="Create" class="btn btn-soft-success">
                <i class="bi bi-plus-circle-fill"></i> Upload Picture Event
            </a>
        </div>
        <div class="row g-3">
            @if (!recentEvents.Any() && !recentBulletins.Any())
            {
                <div class="col-12 text-center py-4">
                    <i class="bi bi-images fs-1 mb-2" style="color: var(--cc-slate-300);"></i>
                    <p style="color: var(--cc-slate-600); font-size: 0.85rem;">No headlines or pictures posted yet.</p>
                </div>
            }
            else
            {
                @foreach (var ev in recentEvents)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card cc-card border-0 shadow-sm h-100 overflow-hidden" style="background-color: var(--cc-slate-50);">
                            @if (ev.ImageData != null)
                            {
                                <img src="/Events/Image/@ev.EventId" alt="@ev.Title" class="w-100" style="height: 140px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 d-flex align-items-center justify-content-center text-primary" style="height: 140px; background-color: var(--cc-blue-surface); font-size: 2.2rem;">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                            }
                            <div class="card-body p-3">
                                <span class="pill-cc-blue mb-1">Event &bull; @ev.Category</span>
                                <div class="fw-bold text-truncate" style="color: var(--cc-slate-900); font-size: 0.90rem;" title="@ev.Title">@ev.Title</div>
                                <small style="color: var(--cc-slate-500);" class="d-block mt-1"><i class="bi bi-geo-alt me-1"></i>@ev.Location</small>
                            </div>
                        </div>
                    </div>
                }
                @foreach (var b in recentBulletins.Take(2))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card cc-card border-0 shadow-sm h-100 overflow-hidden" style="background-color: var(--cc-slate-50);">
                            @if (b.ImageData != null)
                            {
                                <img src="/Bulletins/Image/@b.BulletinId" alt="@b.Title" class="w-100" style="height: 140px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 d-flex align-items-center justify-content-center text-warning" style="height: 140px; background-color: var(--cc-orange-surface); font-size: 2.2rem;">
                                    <i class="bi bi-megaphone"></i>
                                </div>
                            }
                            <div class="card-body p-3">
                                <span class="pill-cc-orange mb-1">Bulletin &bull; @b.Category</span>
                                <div class="fw-bold text-truncate" style="color: var(--cc-slate-900); font-size: 0.90rem;" title="@b.Title">@b.Title</div>
                                <small style="color: var(--cc-slate-500);" class="d-block mt-1"><i class="bi bi-person me-1"></i>@b.Author</small>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="cc-gradient-bar-rainbow"></div>
</div>

<!-- Quick Actions -->
<div class="row g-3">
    <!-- Events Actions -->
    <div class="col-lg-6">
        <div class="card cc-card border-0 shadow-sm h-100">
            <div class="card-body px-4 py-3">
                <p class="cc-section-label mb-3"><i class="bi bi-calendar3 me-1"></i> Events Management</p>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Events" asp-action="Create" class="btn btn-soft-primary justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle-fill fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">Add New Event</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">Schedule a campus event or activity</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-soft-secondary justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-list-ul fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">View All Events</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">Browse, edit, or delete events</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="cc-gradient-bar-blue"></div>
        </div>
    </div>

    <!-- Bulletins Actions -->
    <div class="col-lg-6">
        <div class="card cc-card border-0 shadow-sm h-100">
            <div class="card-body px-4 py-3">
                <p class="cc-section-label mb-3"><i class="bi bi-megaphone me-1"></i> Bulletin Board</p>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Bulletins" asp-action="Create" class="btn btn-soft-warning justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-plus-square-fill fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">Post New Bulletin</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">Create an announcement or notice</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="Bulletins" asp-action="Index" class="btn btn-soft-secondary justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-journals fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">Manage Bulletins</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">View, edit, or remove bulletins</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="cc-gradient-bar-orange"></div>
        </div>
    </div>

    <!-- Site Customization -->
    <div class="col-lg-6">
        <div class="card cc-card border-0 shadow-sm h-100">
            <div class="card-body px-4 py-3">
                <p class="cc-section-label mb-3"><i class="bi bi-palette me-1"></i> Site Customization</p>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="SiteSettings" asp-action="Index" class="btn btn-soft-purple justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-brush-fill fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">Customize Website</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">Edit hero text, colors, tagline &amp; footer</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-soft-secondary justify-content-between p-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-eye fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold" style="font-size: 0.88rem;">Preview Live Site</div>
                                <div style="font-size: 0.72rem; opacity: 0.8;">See how the homepage looks to visitors</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="cc-gradient-bar-purple"></div>
        </div>
    </div>

    <!-- Admin-only: User Management -->
    @if (isAdmin)
    {
        <div class="col-lg-6">
            <div class="card cc-card border-0 shadow-sm h-100">
                <div class="card-body px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <p class="cc-section-label mb-0"><i class="bi bi-shield-fill-check me-1"></i> Admin Controls</p>
                        <span class="pill-cc-orange">ADMIN ONLY</span>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Account" asp-action="Index" class="btn btn-soft-primary justify-content-between p-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-people-fill fs-5"></i>
                                <div class="text-start">
                                    <div class="fw-bold" style="font-size: 0.88rem;">Manage Users</div>
                                    <div style="font-size: 0.72rem; opacity: 0.8;">Create, edit, delete accounts &amp; roles</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="Account" asp-action="Create" class="btn btn-soft-success justify-content-between p-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-plus-fill fs-5"></i>
                                <div class="text-start">
                                    <div class="fw-bold" style="font-size: 0.88rem;">Add New User</div>
                                    <div style="font-size: 0.72rem; opacity: 0.8;">Create account with Admin or User role</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
                <div class="cc-gradient-bar-green"></div>
            </div>
        </div>
    }
</div>

