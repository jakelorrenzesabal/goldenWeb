@using golenWeb.Models
@{
    ViewData["Title"] = "Golden Success College - Official Website";
    var todayEvents = ViewData["TodayEvents"] as List<EventModel> ?? new List<EventModel>();
    var bulletins = ViewData["Bulletins"] as List<Bulletin> ?? new List<Bulletin>();
    var todayStr = DateTime.Today.ToString("dddd, MMMM dd, yyyy");
}

<style>
    .hero-container {
        background: linear-gradient(135deg, #073d1a 0%, #0b5e28 55%, #0f172a 100%);
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 36px rgba(7, 61, 26, 0.2);
    }
    .hero-badge {
        animation: pulseGlow 2.5s infinite;
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5); }
        70% { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    .hero-img {
        transition: transform 0.5s ease;
    }
    .hero-container:hover .hero-img {
        transform: scale(1.06) rotate(2deg);
    }

    .modern-item {
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border-left: 4px solid transparent;
    }
    .modern-item:hover {
        background-color: #f8fafc;
        border-left-color: #0b5e28;
        transform: translateX(4px);
    }

    .quick-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .quick-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 30px rgba(0, 0, 0, 0.07);
        border-color: rgba(11, 94, 40, 0.3);
    }
    .quick-card .icon-box {
        transition: transform 0.3s ease;
    }
    .quick-card:hover .icon-box {
        transform: scale(1.2) rotate(6deg);
    }
</style>

<!-- HERO BANNER WITH ANIMATION -->
<section class="hero-container mb-4 p-4 p-md-5 text-white animate-fade-up">
    <div class="row align-items-center">
        <div class="col-md-3 text-center mb-4 mb-md-0">
            <img src="~/images/logo.png" alt="Golden Success College Logo" class="img-fluid hero-img" style="max-height: 190px; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.4));" />
        </div>
        <div class="col-md-9">
            <span class="badge bg-warning text-dark fw-bold mb-2 hero-badge px-3 py-2 rounded-pill">
                <i class="bi bi-star-fill me-1"></i> OFFICIAL COLLEGE WEBSITE
            </span>
            <h1 class="display-5 fw-extrabold mb-2 text-white" style="letter-spacing:-0.5px;">Golden Success College</h1>
            <p class="fs-5 text-light opacity-90 mb-1 fw-semibold"><em>"Determination &bull; Courage &bull; Hardwork"</em></p>
            <p class="small text-warning opacity-75 mb-4">Isa. 33:6</p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Events" asp-action="Index" class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm btn-modern">
                    <i class="bi bi-calendar-event me-2"></i>Events Calendar
                </a>
                <a asp-controller="Bulletins" asp-action="Index" class="btn btn-light fw-bold text-success px-4 py-2 rounded-pill shadow-sm btn-modern">
                    <i class="bi bi-megaphone me-2"></i>Campus Bulletins
                </a>
                <a asp-controller="Events" asp-action="Create" class="btn btn-outline-light fw-bold px-4 py-2 rounded-pill btn-modern">
                    <i class="bi bi-plus-circle me-2"></i>Post an Event
                </a>
            </div>
        </div>
    </div>
</section>

<!-- TODAY'S DATE & SCHEDULE BANNER -->
<div class="card border-0 shadow-sm mb-4 animate-fade-up animate-delay-1" style="background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%); border-left: 6px solid #0b5e28 !important; border-radius:14px;">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between py-3 px-4">
        <div class="d-flex align-items-center mb-2 mb-md-0">
            <div class="p-2 rounded-circle bg-success text-white me-3 d-flex align-items-center justify-content-center shadow-sm" style="width:45px; height:45px;">
                <i class="bi bi-calendar3 fs-4"></i>
            </div>
            <div>
                <strong class="fs-6 text-dark">Today is <span class="text-success fw-bold">@todayStr</span></strong>
                <div class="small text-muted">@todayEvents.Count scheduled campus event(s) today</div>
            </div>
        </div>
        <a asp-controller="Events" asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-success fw-bold px-3 py-2 rounded-pill btn-modern">
            <i class="bi bi-clock-history me-1"></i>View Today's Schedule
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- TODAY'S EVENTS WIDGET -->
    <div class="col-lg-7 animate-fade-up animate-delay-2">
        <div class="card card-modern h-100 overflow-hidden">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center border-0">
                <span class="fw-bold fs-6"><i class="bi bi-calendar-check me-2"></i>Today's Campus Events</span>
                <a asp-controller="Events" asp-action="Create" class="btn btn-sm btn-light text-success fw-bold rounded-pill btn-modern">
                    <i class="bi bi-plus-lg me-1"></i>Add Event
                </a>
            </div>
            <div class="card-body p-0">
                @if (!todayEvents.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <p class="mb-2 fw-semibold">No events scheduled for today.</p>
                        <a asp-controller="Events" asp-action="Create" class="btn btn-sm btn-outline-success rounded-pill btn-modern">
                            <i class="bi bi-plus-circle me-1"></i>Schedule Event
                        </a>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ev in todayEvents)
                        {
                            <li class="list-group-item px-4 py-3 modern-item" style="cursor: pointer;" onclick="openEventModal(@ev.Id)">
                                <div class="d-flex align-items-center gap-3">
                                    @if (ev.ImageData != null)
                                    {
                                        <img src="/Events/Image/@ev.Id" alt="@ev.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 62px; height: 62px; object-fit: cover; border: 2px solid #0b5e28;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-3 flex-shrink-0 d-flex align-items-center justify-content-center bg-success text-warning shadow-sm" style="width: 62px; height: 62px; font-size: 1.6rem;">
                                            <i class="bi bi-calendar-event"></i>
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        <span class="badge bg-success mb-1 rounded-pill">@ev.Category</span>
                                        <div class="fw-bold text-dark fs-6">@ev.Title</div>
                                        <small class="text-muted d-block mt-1">
                                            <i class="bi bi-clock me-1 text-primary"></i>@ev.StartTime – @ev.EndTime
                                            &bull; <i class="bi bi-geo-alt me-1 text-danger"></i>@ev.Location
                                        </small>
                                    </div>
                                    <a asp-controller="Events" asp-action="Edit" asp-route-id="@ev.Id" onclick="event.stopPropagation();" class="btn btn-sm btn-light border flex-shrink-0 rounded-circle p-2" title="Edit Event">
                                        <i class="bi bi-pencil text-secondary"></i>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-light border-0 py-3 px-4">
                <a asp-controller="Events" asp-action="Index" class="text-success fw-bold text-decoration-none small">
                    View Full Event Calendar <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- BULLETIN BOARD WIDGET -->
    <div class="col-lg-5 animate-fade-up animate-delay-2">
        <div class="card card-modern h-100 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center border-0">
                <span class="fw-bold fs-6"><i class="bi bi-megaphone me-2 text-warning"></i>Latest Bulletins</span>
                <a asp-controller="Bulletins" asp-action="Create" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill btn-modern">
                    <i class="bi bi-plus-lg me-1"></i>Post Notice
                </a>
            </div>
            <div class="card-body p-0">
                @if (!bulletins.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-card-checklist fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <p class="mb-0 fw-semibold">No bulletins posted yet.</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var b in bulletins.Take(4))
                        {
                            var badge = b.Priority == "High" ? "bg-danger" : "bg-secondary";
                            <li class="list-group-item px-4 py-3 modern-item" style="cursor: pointer;" onclick="openBulletinModal(@b.Id)">
                                <div class="d-flex align-items-center gap-3">
                                    @if (b.ImageData != null)
                                    {
                                        <img src="/Bulletins/Image/@b.Id" alt="@b.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 58px; height: 58px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-3 flex-shrink-0 d-flex align-items-center justify-content-center bg-dark text-warning shadow-sm" style="width: 58px; height: 58px; font-size: 1.4rem;">
                                            <i class="bi bi-megaphone-fill"></i>
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="badge @badge rounded-pill">@b.Priority</span>
                                            <span class="badge bg-light text-dark border rounded-pill">@b.Category</span>
                                        </div>
                                        <div class="fw-bold text-dark" style="font-size:0.95rem;">@b.Title</div>
                                        <small class="text-muted d-block mt-1">@b.Author &bull; @b.PublishDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-light border-0 py-3 px-4">
                <a asp-controller="Bulletins" asp-action="Index" class="text-dark fw-bold text-decoration-none small">
                    View All Bulletins <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- QUICK ACCESS CARDS -->
<div class="row g-4 mt-2 animate-fade-up animate-delay-3">
    <div class="col-md-4">
        <div class="card quick-card h-100 text-center p-4">
            <div class="card-body">
                <div class="fs-1 text-success mb-3 icon-box"><i class="bi bi-calendar-event-fill"></i></div>
                <h5 class="fw-bold">Event Calendar</h5>
                <p class="text-muted small mb-4">Schedule, view, and manage campus events with uploaded pictures.</p>
                <a asp-controller="Events" asp-action="Create" class="btn btn-success btn-sm px-4 py-2 rounded-pill fw-bold btn-modern">
                    <i class="bi bi-plus-lg me-1"></i>Add Event
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card quick-card h-100 text-center p-4">
            <div class="card-body">
                <div class="fs-1 text-warning mb-3 icon-box"><i class="bi bi-megaphone-fill"></i></div>
                <h5 class="fw-bold">Bulletin Board</h5>
                <p class="text-muted small mb-4">Post official college announcements and campus notices.</p>
                <a asp-controller="Bulletins" asp-action="Create" class="btn btn-warning text-dark btn-sm px-4 py-2 rounded-pill fw-bold btn-modern">
                    <i class="bi bi-plus-lg me-1"></i>Post Bulletin
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card quick-card h-100 text-center p-4">
            <div class="card-body">
                <div class="fs-1 text-dark mb-3 icon-box"><i class="bi bi-code-slash"></i></div>
                <h5 class="fw-bold">API Tester</h5>
                <p class="text-muted small mb-4">Send live HTTP GET, POST, PUT, DELETE requests to the REST API.</p>
                <a asp-controller="CrudTest" asp-action="Index" class="btn btn-dark btn-sm px-4 py-2 rounded-pill fw-bold btn-modern">
                    <i class="bi bi-send me-1"></i>Test API
                </a>
            </div>
        </div>
    </div>
</div>
