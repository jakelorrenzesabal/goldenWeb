@model golenWeb.Models.EventModel

@{
    ViewData["Title"] = Model.Title + " - Campus Event";
    var absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Events/Details/{Model.EventId}";
    var imageUrl = Model.ImageData != null ? $"{Context.Request.Scheme}://{Context.Request.Host}/Events/Image/{Model.EventId}" : $"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png";
    var fbShareUrl = $"https://www.facebook.com/sharer/sharer.php?u={System.Net.WebUtility.UrlEncode(absoluteUrl)}";
    var isToday = Model.EventDate.ToString("yyyy-MM-dd") == DateTime.Today.ToString("yyyy-MM-dd");
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    // Open Graph Meta Tags for Social Media / Facebook Sharing
    ViewData["OgTitle"] = Model.Title;
    ViewData["OgDescription"] = string.IsNullOrEmpty(Model.Description) ? $"Join us for {Model.Title} at Golden Success College on {Model.EventDate.ToString("MMM dd, yyyy")}." : Model.Description;
    ViewData["OgImage"] = imageUrl;
    ViewData["OgUrl"] = absoluteUrl;
}

<div class="container py-2">
    <!-- Breadcrumb & Back Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-soft-secondary">
            <i class="bi bi-arrow-left"></i> Back to Events Calendar
        </a>
        <div class="d-flex gap-2">
            <button class="btn btn-soft-primary" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;">
                <i class="bi bi-facebook"></i> Share to Facebook
            </button>
            <button class="btn btn-soft-success" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Link copied to clipboard!');">
                <i class="bi bi-link-45deg"></i> Copy Link
            </button>
        </div>
    </div>

    <!-- Main Event Details Card -->
    <div class="card cc-card border-0 shadow-sm overflow-hidden">
        @if (Model.ImageData != null)
        {
            <div class="position-relative" style="max-height: 420px; overflow: hidden; background: var(--cc-slate-900);">
                <img src="/Events/Image/@Model.EventId" alt="@Model.Title" class="w-100" style="height: 420px; object-fit: cover;" />
                <span class="pill-cc-slate position-absolute top-0 end-0 m-3">
                    <i class="bi bi-database-fill-check text-warning me-1"></i>Official Event Photo
                </span>
            </div>
        }

        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (isToday)
                {
                    <span class="pill-cc-red">
                        <i class="bi bi-record-fill me-1"></i>TODAY'S EVENT
                    </span>
                }
                <span class="pill-cc-blue">@Model.Category</span>
                <span class="pill-cc-slate">
                    <i class="bi bi-calendar3 me-1"></i>@Model.EventDate.ToString("MMMM dd, yyyy (ddd)")
                </span>
            </div>

            <h1 class="fw-bold mb-3" style="color: var(--cc-slate-900); font-size: 1.75rem;">@Model.Title</h1>

            <!-- Quick Specs Row -->
            <div class="row g-3 p-3 p-md-4 rounded-3 mb-4 border" style="background-color: var(--cc-slate-50); border-color: var(--cc-slate-200) !important;">
                <div class="col-md-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width:40px; height:40px; background-color: var(--cc-green-surface);">
                        <i class="bi bi-clock" style="color: var(--cc-green-text); font-size: 1rem;"></i>
                    </div>
                    <div>
                        <p class="cc-section-label mb-0" style="font-size:0.65rem;">Schedule</p>
                        <strong style="color: var(--cc-slate-900); font-size: 0.90rem;">@Model.StartTime – @Model.EndTime</strong>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width:40px; height:40px; background-color: var(--cc-red-surface);">
                        <i class="bi bi-geo-alt-fill" style="color: var(--cc-red-text); font-size: 1rem;"></i>
                    </div>
                    <div>
                        <p class="cc-section-label mb-0" style="font-size:0.65rem;">Venue</p>
                        <strong style="color: var(--cc-slate-900); font-size: 0.90rem;">@Model.Location</strong>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width:40px; height:40px; background-color: var(--cc-blue-surface);">
                        <i class="bi bi-person-badge" style="color: var(--cc-blue-text); font-size: 1rem;"></i>
                    </div>
                    <div>
                        <p class="cc-section-label mb-0" style="font-size:0.65rem;">Organizer</p>
                        <strong style="color: var(--cc-slate-900); font-size: 0.90rem;">@Model.Organizer</strong>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <p class="cc-section-label mb-2"><i class="bi bi-info-circle me-1"></i> About This Event</p>
            <div class="mb-4" style="white-space: pre-line; line-height: 1.7; color: var(--cc-slate-600); font-size: 0.90rem;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description has been added for this event." : Model.Description)
            </div>

            <hr class="my-4" style="border-color: var(--cc-slate-200);" />

            <!-- Social Share Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 rounded-3 border" style="background-color: #ffffff; border-color: var(--cc-slate-200) !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-share-fill text-primary"></i>
                    <strong style="color: var(--cc-slate-900); font-size: 0.88rem;">Share Event Announcement:</strong>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@fbShareUrl" target="_blank" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;" class="btn btn-soft-primary">
                        <i class="bi bi-facebook"></i> Post to Facebook
                    </a>
                    <button type="button" class="btn btn-soft-secondary" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Permalink copied to clipboard!\n' + '@absoluteUrl');">
                        <i class="bi bi-clipboard-check"></i> Copy Event Link
                    </button>
                </div>
            </div>

            <!-- Admin Actions: ONLY for logged-in users -->
            @if (isAuthenticated)
            {
                <div class="mt-4 pt-3 d-flex justify-content-end gap-2 border-top" style="border-color: var(--cc-slate-100) !important;">
                    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-soft-primary">
                        <i class="bi bi-pencil-fill"></i> Edit Event
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.EventId" class="btn btn-soft-danger">
                        <i class="bi bi-trash-fill"></i> Delete Event
                    </a>
                </div>
            }
        </div>
        <div class="cc-gradient-bar-blue"></div>
    </div>
</div>

