@model golenWeb.Models.EventModel

@{
    ViewData["Title"] = Model.Title + " - Campus Event";
    var absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Events/Details/{Model.Id}";
    var imageUrl = Model.ImageData != null ? $"{Context.Request.Scheme}://{Context.Request.Host}/Events/Image/{Model.Id}" : $"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png";
    var fbShareUrl = $"https://www.facebook.com/sharer/sharer.php?u={System.Net.WebUtility.UrlEncode(absoluteUrl)}";
    var isToday = Model.EventDate.ToString("yyyy-MM-dd") == DateTime.Today.ToString("yyyy-MM-dd");

    // Open Graph Meta Tags for Social Media / Facebook Sharing
    ViewData["OgTitle"] = Model.Title;
    ViewData["OgDescription"] = string.IsNullOrEmpty(Model.Description) ? $"Join us for {Model.Title} at Golden Success College on {Model.EventDate.ToString("MMM dd, yyyy")}." : Model.Description;
    ViewData["OgImage"] = imageUrl;
    ViewData["OgUrl"] = absoluteUrl;
}

<div class="container py-2">
    <!-- Breadcrumb & Back Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-modern">
            <i class="bi bi-arrow-left me-1"></i> Back to Events Calendar
        </a>
        <div class="d-flex gap-2">
            <button class="btn btn-primary fw-bold shadow-sm rounded-pill px-3" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;">
                <i class="bi bi-facebook me-1"></i> Share to Facebook
            </button>
            <button class="btn btn-outline-success fw-bold shadow-sm rounded-pill px-3" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Link copied to clipboard!');">
                <i class="bi bi-link-45deg me-1"></i> Copy Link
            </button>
        </div>
    </div>

    <!-- Main Event Details Card -->
    <div class="card card-modern border-0 shadow-lg overflow-hidden animate-fade-up">
        @if (Model.ImageData != null)
        {
            <div class="position-relative bg-dark" style="max-height: 420px; overflow: hidden;">
                <img src="/Events/Image/@Model.Id" alt="@Model.Title" class="w-100" style="height: 420px; object-fit: cover;" />
                <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-3 px-3 py-2 fs-6">
                    <i class="bi bi-database-fill-check text-warning me-1"></i>Official Event Photo
                </span>
            </div>
        }

        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (isToday)
                {
                    <span class="badge bg-danger px-3 py-2 fs-6">
                        <i class="bi bi-record-fill me-1"></i>TODAY'S EVENT
                    </span>
                }
                <span class="badge bg-success px-3 py-2 fs-6">@Model.Category</span>
                <span class="badge bg-secondary px-3 py-2 fs-6">
                    <i class="bi bi-calendar3 me-1"></i>@Model.EventDate.ToString("MMMM dd, yyyy (ddd)")
                </span>
            </div>

            <h1 class="display-6 fw-extrabold text-dark mb-3">@Model.Title</h1>

            <!-- Quick Specs Row -->
            <div class="row g-3 bg-light p-3 p-md-4 rounded-4 mb-4 border">
                <div class="col-md-4 d-flex align-items-center">
                    <div class="p-3 rounded-circle bg-success text-white me-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-clock fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.75rem;">Time Schedule</small>
                        <strong class="text-dark fs-6">@Model.StartTime – @Model.EndTime</strong>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="p-3 rounded-circle bg-danger text-white me-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.75rem;">Venue / Location</small>
                        <strong class="text-dark fs-6">@Model.Location</strong>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="p-3 rounded-circle bg-primary text-white me-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.75rem;">Organizer</small>
                        <strong class="text-dark fs-6">@Model.Organizer</strong>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <h5 class="fw-bold text-success mb-3"><i class="bi bi-info-circle me-2"></i>About This Event</h5>
            <div class="fs-6 text-secondary mb-4 leading-relaxed" style="white-space: pre-line; line-height: 1.7;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description has been added for this event." : Model.Description)
            </div>

            <hr class="my-4" />

            <!-- Social Share Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white p-3 rounded-3 border">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-share-fill text-success fs-5"></i>
                    <strong class="text-dark">Share Event Announcement:</strong>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@fbShareUrl" target="_blank" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;" class="btn btn-primary fw-bold rounded-pill btn-modern">
                        <i class="bi bi-facebook me-2"></i>Post to Facebook
                    </a>
                    <button type="button" class="btn btn-outline-dark fw-bold rounded-pill btn-modern" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Permalink copied to clipboard!\n' + '@absoluteUrl');">
                        <i class="bi bi-clipboard-check me-2"></i>Copy Event Link
                    </button>
                </div>
            </div>

            <!-- Admin Actions -->
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <div class="mt-4 pt-3 d-flex justify-content-end gap-2 border-top">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-pencil me-1"></i> Edit Event
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill">
                        <i class="bi bi-trash me-1"></i> Delete Event
                    </a>
                </div>
            }
        </div>
    </div>
</div>
