@model golenWeb.Models.EventModel

@{
    ViewData["Title"] = "Edit Event Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white p-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Event #@Model.Id</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Event Title</label>
                        <input asp-for="Title" class="form-control form-control-lg" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Existing & New Photo Upload (Database Stored, Max 2MB) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-database-fill-check text-success me-1"></i>Event Banner Photo</label>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImageUrl" alt="Current Event Banner" class="img-fluid rounded-3 shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover; border: 2px solid #0b5e28;" />
                                <div class="small text-muted mt-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Current photo loaded directly from database table.</div>
                            </div>
                        }
                        <input type="file" name="imageFile" accept="image/*" class="form-control" id="eventImgInput" onchange="previewEventImg(this)" />
                        <div class="form-text text-muted small"><i class="bi bi-info-circle me-1"></i>Upload a new image to replace the current database photo. <strong>Maximum photo size limit: 2 MB</strong>.</div>
                        <div class="mt-2 text-center d-none" id="eventImgPreviewContainer">
                            <img id="eventImgPreview" src="#" alt="New Banner Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px; object-fit: cover; border: 2px dashed #0b5e28;" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label fw-semibold">Event Date</label>
                            <input asp-for="EventDate" type="date" class="form-control" required />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Event Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Academic">Academic</option>
                                <option value="Ceremony">Ceremony</option>
                                <option value="Seminar">Seminar / Workshop</option>
                                <option value="Sports">Sports & Athletics</option>
                                <option value="Cultural">Cultural & Arts</option>
                                <option value="Club">Student Club Activity</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-semibold">Start Time</label>
                            <input asp-for="StartTime" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label fw-semibold">End Time</label>
                            <input asp-for="EndTime" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold">Venue / Location</label>
                            <input asp-for="Location" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Organizer" class="form-label fw-semibold">Organizer</label>
                            <input asp-for="Organizer" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Event Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-dark px-4 fw-bold">Update Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewEventImg(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            var maxBytes = 2 * 1024 * 1024; // 2 MB
            if (file.size > maxBytes) {
                alert('Photo file size exceeds the 2 MB maximum limit! Selected file is ' + (file.size / (1024 * 1024)).toFixed(2) + ' MB. Please select a smaller photo.');
                input.value = '';
                document.getElementById('eventImgPreviewContainer').classList.add('d-none');
                return;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('eventImgPreview');
                var container = document.getElementById('eventImgPreviewContainer');
                preview.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }
</script>
