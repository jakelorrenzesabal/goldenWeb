@model golenWeb.Models.EventModel

@{
    ViewData["Title"] = "Schedule New Campus Event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card cc-card border-0 shadow-sm">
            <div class="card-body px-4 py-3">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px; background-color: var(--cc-green-surface);">
                        <i class="bi bi-calendar-plus-fill" style="color: var(--cc-green-text); font-size: 1rem;"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--cc-slate-900);">Schedule Campus Event</h5>
                        <p class="cc-section-label mb-0" style="font-size: 0.68rem;">Golden Success College · Event Management</p>
                    </div>
                </div>

                <hr class="my-3" style="border-color: var(--cc-slate-100);" />

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold small"></div>

                    <!-- Event Title -->
                    <div class="form-floating mb-3">
                        <input asp-for="Title" class="form-control cc-input" placeholder="Event Title" required />
                        <label asp-for="Title" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                            <i class="bi bi-calendar-event me-1"></i> Event Title
                        </label>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Event Photo Upload -->
                    <div class="mb-3">
                        <label class="form-label text-uppercase fw-semibold" style="font-size: 0.72rem; color: var(--cc-slate-500); letter-spacing: 0.04em;">
                            <i class="bi bi-image me-1"></i> Event Banner Photo (Max 2MB)
                        </label>
                        <input type="file" name="imageFile" accept="image/*" class="form-control cc-input" id="eventImgInput" onchange="previewEventImg(this)" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-check text-success me-1"></i>Stored in database. Maximum photo size limit: 2 MB.
                        </div>
                        <div class="mt-3 text-center d-none" id="eventImgPreviewContainer">
                            <img id="eventImgPreview" src="#" alt="Event Banner Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px; object-fit: cover; border: 1.5px dashed var(--cc-green-border);" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="EventDate" type="date" class="form-control cc-input" placeholder="Event Date" required />
                                <label asp-for="EventDate" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-calendar3 me-1"></i> Event Date
                                </label>
                                <span asp-validation-for="EventDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="Category" class="form-select cc-input" id="eventCategorySelect">
                                    <option value="Academic">Academic</option>
                                    <option value="Ceremony">Ceremony</option>
                                    <option value="Seminar">Seminar / Workshop</option>
                                    <option value="Sports">Sports &amp; Athletics</option>
                                    <option value="Cultural">Cultural &amp; Arts</option>
                                    <option value="Club">Student Club Activity</option>
                                </select>
                                <label for="eventCategorySelect" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-tag me-1"></i> Event Category
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="StartTime" class="form-control cc-input" placeholder="Start Time" required />
                                <label asp-for="StartTime" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-clock me-1"></i> Start Time
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="EndTime" class="form-control cc-input" placeholder="End Time" required />
                                <label asp-for="EndTime" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-clock-history me-1"></i> End Time
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Location" class="form-control cc-input" placeholder="Venue" required />
                                <label asp-for="Location" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-geo-alt me-1"></i> Venue / Location
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Organizer" class="form-control cc-input" placeholder="Organizer" required />
                                <label asp-for="Organizer" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                                    <i class="bi bi-building me-1"></i> Organizer / Department
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control cc-input" placeholder="Description" style="height: 120px;"></textarea>
                        <label asp-for="Description" style="font-size: 0.82rem; color: var(--cc-slate-500);">
                            <i class="bi bi-chat-left-text me-1"></i> Event Details &amp; Program Description
                        </label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: var(--cc-slate-100) !important;">
                        <a asp-action="Index" class="btn btn-soft-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-soft-success">
                            <i class="bi bi-floppy2-fill"></i> Save &amp; Schedule Event
                        </button>
                    </div>
                </form>
            </div>
            <div class="cc-gradient-bar-green"></div>
        </div>
    </div>
</div>

<script>
    function previewEventImg(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            var maxBytes = 2 * 1024 * 1024;
            if (file.size > maxBytes) {
                alert('Photo file size exceeds the 2 MB maximum limit! Selected file is ' + (file.size / (1024 * 1024)).toFixed(2) + ' MB. Please select a smaller photo.');
                input.value = '';
                document.getElementById('eventImgPreviewContainer').classList.add('d-none');
                return;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('eventImgPreview');
                var container = document.getElementById('eventImgPreviewContainer');
                preview.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }
</script>

