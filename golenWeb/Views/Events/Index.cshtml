@model IEnumerable<golenWeb.Models.EventModel>

@{
    ViewData["Title"] = "Campus Event Schedule & Calendar";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-success">
            <i class="bi bi-calendar-event me-2"></i>Campus Event Schedule
        </h2>
        <p class="text-muted mb-0">Golden Success College Daily Bulletin & Event Calendar</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Any())
        {
            <form asp-action="DeleteAll" method="post" onsubmit="return confirm('Are you sure you want to delete ALL scheduled events?');" class="d-inline">
                <button type="submit" class="btn btn-outline-danger shadow-sm">
                    <i class="bi bi-trash3 me-1"></i> Clear All Events
                </button>
            </form>
        }
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm px-4 fw-bold">
            <i class="bi bi-calendar-plus me-2"></i>Schedule New Event
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Date Filter Bar -->
<div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Search Keywords</label>
                <input type="text" name="search" class="form-control" placeholder="Search event title, venue, or organizer..." value="@ViewData["CurrentSearch"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Category</label>
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    <option value="Academic">Academic</option>
                    <option value="Ceremony">Ceremony</option>
                    <option value="Seminar">Seminar</option>
                    <option value="Sports">Sports</option>
                    <option value="Cultural">Cultural</option>
                    <option value="Club">Club Activity</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Filter Date</label>
                <input type="date" name="date" class="form-control" value="@ViewData["SelectedDate"]" />
            </div>
            <div class="col-md-2 d-flex gap-1 align-self-end">
                <button type="submit" class="btn btn-success w-100 fw-bold"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Event List Cards -->
<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                    <h4 class="fw-bold text-dark">No Events Scheduled</h4>
                    <p class="text-muted">There are no college events scheduled matching your criteria.</p>
                    <a asp-action="Create" class="btn btn-success mt-2">
                        <i class="bi bi-plus-circle me-1"></i> Add Event Now
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var ev in Model)
        {
            var isToday = ev.EventDate.ToString("yyyy-MM-dd") == todayStr;
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm overflow-hidden @(isToday ? "border-start border-4 border-success" : "")">
                    @if (!string.IsNullOrEmpty(ev.ImageUrl))
                    {
                        <div style="position:relative; max-height: 200px; overflow: hidden; background: #1b2a4a;">
                            <img src="@ev.ImageUrl" alt="@ev.Title" class="w-100" style="height: 200px; object-fit: cover; transition: transform 0.3s ease;" loading="lazy" />
                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2 px-2 py-1 small">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Fast Hashed Asset
                            </span>
                        </div>
                    }
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <div class="d-flex align-items-center gap-2">
                            @if (isToday)
                            {
                                <span class="badge bg-danger animate__animated animate__pulse animate__infinite">
                                    <i class="bi bi-record-fill me-1"></i>TODAY'S EVENT
                                </span>
                            }
                            <span class="badge bg-success">@ev.Category</span>
                        </div>
                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@ev.StartTime - @ev.EndTime</small>
                    </div>
                    <div class="card-body">
                        <h4 class="fw-bold text-dark mb-2">@ev.Title</h4>
                        <p class="text-secondary mb-3">@(string.IsNullOrEmpty(ev.Description) ? "No description provided." : ev.Description)</p>
                        
                        <div class="row g-2 bg-light p-2 rounded small mb-3">
                            <div class="col-6">
                                <i class="bi bi-calendar3 me-1 text-success"></i>
                                <strong>Date:</strong> @ev.EventDate.ToString("MMMM dd, yyyy (ddd)")
                            </div>
                            <div class="col-6">
                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i>
                                <strong>Venue:</strong> @ev.Location
                            </div>
                            <div class="col-12 mt-1">
                                <i class="bi bi-person-badge me-1 text-primary"></i>
                                <strong>Organizer:</strong> @ev.Organizer
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-end gap-2 border-0 pb-3">
                        <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
