@{
    ViewData["Title"] = "Create User";
}

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 2.5rem;
        max-width: 540px;
        margin: 0 auto;
    }
    .form-card .form-label { font-weight: 600; font-size: 0.88rem; color: #444; }
    .form-card .form-control, .form-card .form-select {
        border: 1.5px solid #e8e8e8;
        border-radius: 8px;
        padding: 0.65rem 0.9rem;
        font-size: 0.9rem;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
        border-color: #0b5e28;
        box-shadow: 0 0 0 3px rgba(11,94,40,0.1);
    }
    .btn-create { background: linear-gradient(135deg,#0b5e28,#1a8c45); color:white; border:none; border-radius:10px; padding:0.7rem 2rem; font-weight:700; }
    .btn-create:hover { color:white; opacity:0.9; }
</style>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm position-relative overflow-hidden">
            <div class="cc-gradient-bar cc-gradient-bar-emerald"></div>
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="p-3 bg-light-emerald rounded-3 text-success">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="cc-section-label text-success">User Administration</div>
                        <h2 class="h4 fw-bold text-dark mb-0">Create New Account</h2>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4 rounded-3 small">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="bi bi-exclamation-circle me-1"></i>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post" asp-action="Create">
                    <div class="form-floating mb-3">
                        <input name="username" class="form-control cc-input" id="username" placeholder="Username" required />
                        <label for="username">Username *</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="email" type="email" class="form-control cc-input" id="email" placeholder="Email Address" />
                        <label for="email">Email Address</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="password" type="password" class="form-control cc-input" id="password" placeholder="Password" required />
                        <label for="password">Password *</label>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Assigned Security Role *</label>
                        <select name="role" class="form-select cc-input">
                            <option value="User" selected>👤 User — Content Editor</option>
                            <option value="Admin">🛡️ Admin — Full Administrator Access</option>
                        </select>
                        <div class="form-text extra-small text-muted mt-1">
                            <strong>User:</strong> Standard access to modify events and bulletins. &nbsp;
                            <strong>Admin:</strong> System-wide control and user account management.
                        </div>
                    </div>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-soft-success fw-bold px-4">
                                <i class="bi bi-person-plus me-1"></i>Create User
                            </button>
                            <a asp-action="Index" class="btn btn-soft-secondary text-secondary px-4">Cancel</a>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
