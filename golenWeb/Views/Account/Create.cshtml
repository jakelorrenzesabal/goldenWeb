@{
    ViewData["Title"] = "Create User";
}

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 2.5rem;
        max-width: 540px;
        margin: 0 auto;
    }
    .form-card .form-label { font-weight: 600; font-size: 0.88rem; color: #444; }
    .form-card .form-control, .form-card .form-select {
        border: 1.5px solid #e8e8e8;
        border-radius: 8px;
        padding: 0.65rem 0.9rem;
        font-size: 0.9rem;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
        border-color: #0b5e28;
        box-shadow: 0 0 0 3px rgba(11,94,40,0.1);
    }
    .btn-create { background: linear-gradient(135deg,#0b5e28,#1a8c45); color:white; border:none; border-radius:10px; padding:0.7rem 2rem; font-weight:700; }
    .btn-create:hover { color:white; opacity:0.9; }
</style>

<div class="d-flex justify-content-center">
    <div class="form-card w-100">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#0b5e28,#1a8c45);display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-person-plus-fill text-white" style="font-size:1.3rem;"></i>
            </div>
            <div>
                <h2 class="mb-0" style="font-size:1.4rem;font-weight:800;">Create New User</h2>
                <p class="mb-0 text-muted" style="font-size:0.82rem;">Admin can assign any role</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="Create">
            <div class="mb-3">
                <label class="form-label">Username <span class="text-danger">*</span></label>
                <input name="username" class="form-control" placeholder="e.g. john.doe" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control" placeholder="user@goldensuccess.edu" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password <span class="text-danger">*</span></label>
                <input name="password" type="password" class="form-control" placeholder="Minimum 6 characters" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Role <span class="text-danger">*</span></label>
                <select name="role" class="form-select">
                    <option value="User" selected>👤 User — Content editor only</option>
                    <option value="Admin">🛡️ Admin — Full access</option>
                </select>
                <div class="form-text text-muted mt-1">
                    <strong>User:</strong> Can create/edit events & bulletins, customize site. &nbsp;
                    <strong>Admin:</strong> All of the above + manage users.
                </div>
            </div>
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-create">
                    <i class="bi bi-person-plus me-2"></i>Create User
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
