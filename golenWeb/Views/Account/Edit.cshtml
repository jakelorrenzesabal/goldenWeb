@model golenWeb.Models.User
@{
    ViewData["Title"] = "Edit User";
}

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 2.5rem;
        max-width: 540px;
        margin: 0 auto;
    }
    .form-card .form-label { font-weight: 600; font-size: 0.88rem; color: #444; }
    .form-card .form-control, .form-card .form-select {
        border: 1.5px solid #e8e8e8;
        border-radius: 8px;
        padding: 0.65rem 0.9rem;
        font-size: 0.9rem;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
        border-color: #0b5e28;
        box-shadow: 0 0 0 3px rgba(11,94,40,0.1);
    }
    .btn-save { background: linear-gradient(135deg,#0b5e28,#1a8c45); color:white; border:none; border-radius:10px; padding:0.7rem 2rem; font-weight:700; }
    .btn-save:hover { color:white; opacity:0.9; }
    .user-avatar-lg {
        width: 64px; height: 64px; border-radius: 50%;
        background: linear-gradient(135deg,#0b5e28,#1a8c45);
        color: white; display: flex; align-items: center;
        justify-content: center; font-weight: 800; font-size: 1.6rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm position-relative overflow-hidden">
            <div class="cc-gradient-bar cc-gradient-bar-blue"></div>
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:52px;height:52px;border-radius:50%;background:#dbeafe;color:#2563eb;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.4rem;">
                        @Model.Username.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="cc-section-label text-primary">User Administration</div>
                        <h2 class="h4 fw-bold text-dark mb-0">Edit User Account</h2>
                        <p class="text-muted extra-small mb-0">Account ID #@Model.UserId</p>
                    </div>
                </div>

                <form method="post" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.UserId" />

                    <div class="form-floating mb-3">
                        <input name="username" value="@Model.Username" class="form-control cc-input" id="username" placeholder="Username" required />
                        <label for="username">Username *</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="email" type="email" value="@Model.Email" class="form-control cc-input" id="email" placeholder="Email Address" />
                        <label for="email">Email Address</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Security Role *</label>
                        <select name="role" class="form-select cc-input">
                            @if (Model.Role == "User")
                            {
                                <option value="User" selected>👤 User — Content Editor</option>
                                <option value="Admin">🛡️ Admin — Full Administrator Access</option>
                            }
                            else
                            {
                                <option value="User">👤 User — Content Editor</option>
                                <option value="Admin" selected>🛡️ Admin — Full Administrator Access</option>
                            }
                        </select>
                    </div>

                    <div class="form-floating mb-4">
                        <input name="newPassword" type="password" class="form-control cc-input" id="newPassword" placeholder="New Password" />
                        <label for="newPassword">New Password (leave blank to keep current)</label>
                    </div>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-soft-primary fw-bold px-4">
                                <i class="bi bi-floppy me-1"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-soft-secondary text-secondary px-4">Cancel</a>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
