@model IEnumerable<golenWeb.Models.User>
@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<p><a class="btn btn-success" asp-action="Create">Create new user</a></p>

<table class="table">
    <thead>
        <tr><th>Id</th><th>Username</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
    @foreach(var u in Model){
        <tr>
            <td>@u.Id</td>
            <td>@u.Username</td>
            <td>@u.Email</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@u.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
