@model golenWeb.Models.Bulletin

@{
    ViewData["Title"] = "Edit Bulletin Notice";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark p-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Bulletin Notice</h4>
                <small>Golden Success College Official Bulletin Board</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Notice Title</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Midterm Examination Schedule Announcement" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Bulletin Picture Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-image text-success me-1"></i>Notice Attachment Picture / Banner</label>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImageUrl" alt="Current Bulletin Image" class="img-fluid rounded-3 shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover; border: 2px solid #0b5e28;" />
                                <div class="small text-muted mt-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Current picture loaded from SHA-256 hash path: <code>@Model.ImageUrl</code></div>
                            </div>
                        }
                        <input type="file" name="imageFile" accept="image/*" class="form-control" id="bulletinImgInput" onchange="previewBulletinImg(this)" />
                        <div class="form-text text-muted small"><i class="bi bi-info-circle me-1"></i>Upload a new image to replace the current picture (hashed with SHA-256).</div>
                        <div class="mt-2 text-center d-none" id="bulletinImgPreviewContainer">
                            <img id="bulletinImgPreview" src="#" alt="New Notice Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px; object-fit: cover; border: 2px dashed #0b5e28;" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Academic Notice">Academic Notice</option>
                                <option value="General Notice">General Notice</option>
                                <option value="Urgent Notice">Urgent Notice</option>
                                <option value="Student Activity">Student Activity</option>
                                <option value="Sports">Sports</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Normal">Normal Priority</option>
                                <option value="High">High Priority (Urgent)</option>
                                <option value="Low">Low Priority</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label fw-semibold">Author / Office</label>
                            <input asp-for="Author" class="form-control" placeholder="e.g. Office of Student Affairs" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishDate" class="form-label fw-semibold">Publish Date</label>
                            <input asp-for="PublishDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Announcement Content</label>
                        <textarea asp-for="Content" class="form-control" rows="6" placeholder="Enter complete announcement details..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewBulletinImg(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('bulletinImgPreview');
                var container = document.getElementById('bulletinImgPreviewContainer');
                preview.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
