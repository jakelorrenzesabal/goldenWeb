@model golenWeb.Models.Bulletin

@{
    ViewData["Title"] = Model.Title + " - Campus Bulletin";
    var absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Bulletins/Details/{Model.BulletinId}";
    var imageUrl = Model.ImageData != null ? $"{Context.Request.Scheme}://{Context.Request.Host}/Bulletins/Image/{Model.BulletinId}" : $"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png";
    var fbShareUrl = $"https://www.facebook.com/sharer/sharer.php?u={System.Net.WebUtility.UrlEncode(absoluteUrl)}";
    var isHigh = Model.Priority == "High";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    // Open Graph Meta Tags for Social Media / Facebook Sharing
    ViewData["OgTitle"] = Model.Title;
    ViewData["OgDescription"] = string.IsNullOrEmpty(Model.Content) ? $"Official announcement from Golden Success College." : (Model.Content.Length > 200 ? Model.Content.Substring(0, 197) + "..." : Model.Content);
    ViewData["OgImage"] = imageUrl;
    ViewData["OgUrl"] = absoluteUrl;
}

<div class="container py-2">
    <!-- Breadcrumb & Back Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-soft-secondary">
            <i class="bi bi-arrow-left"></i> Back to Bulletin Board
        </a>
        <div class="d-flex gap-2">
            <button class="btn btn-soft-primary" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;">
                <i class="bi bi-facebook"></i> Share to Facebook
            </button>
            <button class="btn btn-soft-success" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Bulletin link copied to clipboard!');">
                <i class="bi bi-link-45deg"></i> Copy Link
            </button>
        </div>
    </div>

    <!-- Main Bulletin Details Card -->
    <div class="card cc-card border-0 shadow-sm overflow-hidden">
        @if (Model.ImageData != null)
        {
            <div class="position-relative" style="max-height: 420px; overflow: hidden; background: var(--cc-slate-900);">
                <img src="/Bulletins/Image/@Model.BulletinId" alt="@Model.Title" class="w-100" style="height: 420px; object-fit: cover;" />
                <span class="pill-cc-slate position-absolute top-0 end-0 m-3">
                    <i class="bi bi-database-fill-check text-warning me-1"></i>Official Notice Photo
                </span>
            </div>
        }

        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (isHigh)
                {
                    <span class="pill-cc-red"><i class="bi bi-exclamation-triangle-fill me-1"></i>HIGH PRIORITY</span>
                }
                else
                {
                    <span class="pill-cc-blue">NORMAL PRIORITY</span>
                }
                <span class="pill-cc-slate">@Model.Category</span>
                <span class="pill-cc-slate">
                    <i class="bi bi-clock me-1"></i>Posted @Model.PublishDate.ToString("MMMM dd, yyyy")
                </span>
            </div>

            <h1 class="fw-bold mb-3" style="color: var(--cc-slate-900); font-size: 1.75rem;">@Model.Title</h1>

            <!-- Author & Metadata -->
            <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4 border" style="background-color: var(--cc-slate-50); border-color: var(--cc-slate-200) !important;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:40px; height:40px; background-color: var(--cc-orange-surface);">
                    <i class="bi bi-person-fill" style="color: var(--cc-orange-text); font-size: 1rem;"></i>
                </div>
                <div>
                    <p class="cc-section-label mb-0" style="font-size:0.65rem;">Official Notice Author</p>
                    <strong style="color: var(--cc-slate-900); font-size: 0.90rem;">@Model.Author</strong>
                </div>
            </div>

            <!-- Content -->
            <p class="cc-section-label mb-2"><i class="bi bi-megaphone me-1"></i> Notice Content</p>
            <div class="mb-4" style="white-space: pre-line; line-height: 1.8; color: var(--cc-slate-600); font-size: 0.90rem;">
                @Model.Content
            </div>

            <hr class="my-4" style="border-color: var(--cc-slate-200);" />

            <!-- Social Share Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 rounded-3 border" style="background-color: #ffffff; border-color: var(--cc-slate-200) !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-share-fill text-warning"></i>
                    <strong style="color: var(--cc-slate-900); font-size: 0.88rem;">Share Bulletin Notice:</strong>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@fbShareUrl" target="_blank" onclick="window.open('@fbShareUrl', 'fbShareWindow', 'width=600,height=500'); return false;" class="btn btn-soft-primary">
                        <i class="bi bi-facebook"></i> Post to Facebook
                    </a>
                    <button type="button" class="btn btn-soft-secondary" onclick="navigator.clipboard.writeText('@absoluteUrl'); alert('Permalink copied to clipboard!\n' + '@absoluteUrl');">
                        <i class="bi bi-clipboard-check"></i> Copy Bulletin Link
                    </button>
                </div>
            </div>

            <!-- Admin Actions: ONLY for logged-in users -->
            @if (isAuthenticated)
            {
                <div class="mt-4 pt-3 d-flex justify-content-end gap-2 border-top" style="border-color: var(--cc-slate-100) !important;">
                    <a asp-action="Edit" asp-route-id="@Model.BulletinId" class="btn btn-soft-primary">
                        <i class="bi bi-pencil-fill"></i> Edit Bulletin
                    </a>
                </div>
            }
        </div>
        <div class="cc-gradient-bar-orange"></div>
    </div>
</div>

