@model golenWeb.Models.Bulletin

@{
    ViewData["Title"] = "Post Campus Bulletin Notice";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white p-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-megaphone me-2"></i>Post Campus Notice</h4>
                <small class="text-light">Golden Success College Official Bulletin Board</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Notice Title</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Midterm Examination Schedule Announcement" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Bulletin Photo Upload (Stored in DB, Max 2MB) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-database-fill-check text-success me-1"></i>Notice Attachment Photo</label>
                        <input type="file" name="imageFile" accept="image/*" class="form-control" id="bulletinImgInput" onchange="previewBulletinImg(this)" />
                        <div class="form-text text-muted small"><i class="bi bi-shield-check text-success me-1"></i>Stored directly inside database table. <strong>Maximum photo size limit: 2 MB (2,048 KB)</strong>.</div>
                        <div class="mt-3 text-center d-none" id="bulletinImgPreviewContainer">
                            <img id="bulletinImgPreview" src="#" alt="Bulletin Image Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 220px; object-fit: cover; border: 2px dashed #0b5e28;" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Academic Notice">Academic Notice</option>
                                <option value="General Notice">General Notice</option>
                                <option value="Urgent Notice">Urgent Notice</option>
                                <option value="Student Activity">Student Activity</option>
                                <option value="Sports">Sports</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Normal">Normal Priority</option>
                                <option value="High">High Priority (Urgent)</option>
                                <option value="Low">Low Priority</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label fw-semibold">Author / Office</label>
                            <input asp-for="Author" class="form-control" placeholder="e.g. Office of Student Affairs" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishDate" class="form-label fw-semibold">Publish Date</label>
                            <input asp-for="PublishDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Announcement Content</label>
                        <textarea asp-for="Content" class="form-control" rows="6" placeholder="Enter complete announcement details for the college bulletin board..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">Post Bulletin Notice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewBulletinImg(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            var maxBytes = 2 * 1024 * 1024; // 2 MB
            if (file.size > maxBytes) {
                alert('Photo file size exceeds the 2 MB maximum limit! Selected file is ' + (file.size / (1024 * 1024)).toFixed(2) + ' MB. Please select a smaller photo.');
                input.value = '';
                document.getElementById('bulletinImgPreviewContainer').classList.add('d-none');
                return;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('bulletinImgPreview');
                var container = document.getElementById('bulletinImgPreviewContainer');
                preview.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }
</script>
